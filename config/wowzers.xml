            <!-- Motors -->
            <RevRoboticsUltraplanetaryHDHexMotor name="pshooter" port="3" />
            <!-- Servos -->
            <Servo name="sdoor" port="0" />
            <!-- I2C Devices -->
            <LynxEmbeddedIMU name="imu" port="0" bus="0" />
        </LynxModule>
    </LynxUsbDevice>
</Robot>